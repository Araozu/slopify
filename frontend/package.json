		"prettier-plugin-tailwindcss": "^0.7.4",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.0",
		"vite": "npm:@voidzero-dev/vite-plus-core@^0.1.24",
		"vite-plus": "latest"
